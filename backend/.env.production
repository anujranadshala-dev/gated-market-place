# Production environment variables NOT set via this file.
# Sensitive values (JWT_SECRET, MONGO_DB, SMTP_*) should be configured
# in the Vercel Project Settings, NOT in this file.

# CORS Configuration (comma-separated origins)
# Allows cross-origin requests from the deployed admin and client portals.
CORS_ORIGINS=https://gated-market-place-admin-portal.vercel.app,https://gated-market-place-client-portal.vercel.app

# Portal URLs (used for redirects, cookies, and CORS fallback)
ADMIN_PORTAL_URL=https://gated-market-place-admin-portal.vercel.app
CLIENT_PORTAL_URL=https://gated-market-place-client-portal.vercel.app

# --- SMTP / Email Configuration (set in Vercel Project Settings) ---
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=anujranadshala@gmail.com
# SMTP_PASS=<your-16-char-gmail-app-password>
# SMTP_FROM_NAME=Gated Marketplace
# SMTP_FROM_EMAIL=anujranadshala@gmail.com

# Registration control (set to 'true' to allow public admin registration)
# ALLOW_PUBLIC_REGISTRATION=true
